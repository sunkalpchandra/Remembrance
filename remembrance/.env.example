# --- Auth (Clerk) — required ---
# https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Clerk dashboard → Webhooks → endpoint for /api/webhooks/clerk
CLERK_WEBHOOK_SECRET=whsec_...

# --- Database (Neon Postgres) — required ---
# Conversations, messages, memories, notifications, caregiver data
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- Realtime chat backend (Koa + socket.io, `npm run server`) ---
# Where the frontend's socket.io client connects. Leave unset for http://localhost:5000
NEXT_PUBLIC_BACKEND_URL=

# --- LLM inference (backend) ---
# OpenAI-compatible providers used in backend/models.ts
DIGITALOCEAN_KEY=
HACKCLUB_KEY=

# --- Long-term memory (mem0.ai) — optional, DB fallback exists ---
MEM0_API_KEY=

# --- Knowledge graph (Neo4j) — optional, DB fallback exists ---
NEO4J_URL=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Voice input (Picovoice Leopard) — optional ---
NEXT_PUBLIC_PICOVOICE_ACCESS_KEY=
