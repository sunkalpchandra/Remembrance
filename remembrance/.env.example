# --- Auth (Clerk) — required ---
# https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Clerk dashboard → Webhooks → endpoint for /api/webhooks/clerk
CLERK_WEBHOOK_SECRET=whsec_...

# --- Database (Neon Postgres) — required ---
# Conversations, messages, memories, notifications, caregiver data
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- Chat transport ---
# Set this to use the realtime socket backend (`npm run server`, :5001).
# Leave it UNSET to stream chat through the built-in /api/chat route
# instead — no separate backend process needed (this is the Vercel mode).
NEXT_PUBLIC_BACKEND_URL=

# --- LLM inference — at least one of these ---
# Named providers used by the model picker (Max/High/Medium/Low)
DIGITALOCEAN_KEY=
HACKCLUB_KEY=
# …or any OpenAI-compatible endpoint as a catch-all fallback
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# --- Long-term memory (mem0.ai) — optional, Postgres fallback exists ---
MEM0_API_KEY=

# --- Knowledge graph (Neo4j, socket backend only) — optional ---
NEO4J_URL=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Voice input (Picovoice Leopard) — optional ---
NEXT_PUBLIC_PICOVOICE_ACCESS_KEY=
